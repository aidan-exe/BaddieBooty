# PayFast checkout. Copy this file to .env.local. Never commit real merchant keys.
#
# https://developers.payfast.co.za/docs#step_3_testing_your_integration

# Required in every environment, including sandbox. Server-only HMAC key for the
# cart snapshot PayFast echoes back. Generate with: openssl rand -hex 32
# Checkout shows "payments unavailable" until this is set.
PAYFAST_SNAPSHOT_SECRET=

# Public sandbox merchant id and key. They are not a live account.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Leave empty only for the shared test merchant 10000100. That merchant rejects
# signatures, including the sample passphrase jt7NOE43FZPn printed in PayFast's
# docs. Your own sandbox or live account should use the passphrase saved on
# that account's dashboard. Live mode requires a passphrase.
PAYFAST_PASSPHRASE=

# Preview and local dev default to sandbox when this is unset.
# Production (VERCEL_ENV=production) must set it to true or false.
# false posts to live PayFast and requires a merchant id, key, and passphrase.
# The public sandbox id 10000100 is rejected in live mode.
PAYFAST_SANDBOX=true

# Optional absolute origin for return_url, cancel_url, and notify_url.
# Leave unset to use the request host, which covers local dev and Vercel previews.
# PAYFAST_SITE_URL=https://baddie-booty.vercel.app

# Optional path for the append-only order log. Defaults to .data/orders.jsonl,
# then /tmp/baddie-booty-orders.jsonl when that path is not writable.
# ORDER_LOG_PATH=
